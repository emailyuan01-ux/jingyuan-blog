---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props { title?: string; description?: string; image?: string; articleDate?: Date; noindex?: boolean; }
const { title = SITE.title, description = SITE.description, image = '/og-image.svg', articleDate, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f8f8f5" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleDate && <meta property="article:author" content={SITE.author} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE.url).toString()} />
    <meta property="og:image:alt" content={`${SITE.name} · ${SITE.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try { const saved = localStorage.getItem('theme'); if (saved === 'dark' || saved === 'light') theme = saved; } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
