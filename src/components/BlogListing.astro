---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Pagination from './Pagination.astro';
import { getCategories, getTags, PAGE_SIZE, type BlogPost } from '../utils';
import { SITE } from '../config';
interface Props { allPosts: BlogPost[]; current?: number; }
const { allPosts, current = 1 } = Astro.props;
const posts = allPosts.slice((current - 1) * PAGE_SIZE, current * PAGE_SIZE);
const total = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
---
<BaseLayout title={`文章${current > 1 ? ` · 第 ${current} 页` : ''} — ${SITE.name}`} description="思考、阅读、技术与生活的全部记录。">
  <div class="container">
    <header class="page-header"><Breadcrumbs items={[{ label: '文章' }]} /><div class="eyebrow">Writing / {String(allPosts.length).padStart(2, '0')}</div><h1>文章</h1><p>思考、阅读、技术与生活的记录。</p></header>
    <nav class="filters" aria-label="按分类浏览"><a class="filter active" href="/blog/" aria-current="page">全部 · {allPosts.length}</a>{getCategories(allPosts).map((category) => <a class="filter" href={`/categories/${encodeURIComponent(category)}/`}>{category} · {allPosts.filter((post) => post.data.category === category).length}</a>)}</nav>
    <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
    {allPosts.length === 0 && <p class="empty">还没有发布文章，稍后再来看看。</p>}
    <Pagination current={current} total={total} />
    <section class="tag-section"><h2 class="eyebrow">按标签浏览</h2><div class="filters">{getTags(allPosts).map((tag) => <a class="filter" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></section>
  </div>
</BaseLayout>
