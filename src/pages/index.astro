---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { sortPosts, getCategories } from '../utils';
const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const categories = getCategories(posts);
const counts = Object.fromEntries(categories.map((category) => [category, posts.filter((post) => post.data.category === category).length]));
---
<BaseLayout>
  <div class="container">
    <section class="hero">
      <div class="eyebrow">Personal notes · Since 2026</div>
      <h1>{SITE.name}</h1>
      <p>{SITE.intro}</p>
      <span class="signature">{SITE.tagline}</span>
    </section>
    <section class="section home-grid">
      <div>
        <div class="section-heading"><h2>最近文章</h2><a href="/blog/">查看全部 →</a></div>
        <div class="post-list">{posts.slice(0, 4).map((post) => <PostCard post={post} />)}</div>
        {posts.length === 0 && <p class="empty">第一篇文章，正在路上。</p>}
      </div>
      <aside class="home-side">
        <h3>从这里开始</h3>
        <p>这个空间用来存放那些值得慢慢想、慢慢写下来的东西。</p>
        <div class="category-list">{categories.map((category) => <a href={`/categories/${encodeURIComponent(category)}/`}><span>{category}</span><span>{String(counts[category]).padStart(2, '0')}</span></a>)}</div>
        <a class="garden-link" href="/about/">关于这个空间 ↗</a>
      </aside>
    </section>
  </div>
</BaseLayout>
