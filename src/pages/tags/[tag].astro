---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedPosts, getTags } from '../../utils';
import { SITE } from '../../config';
export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  return getTags(allPosts).map((tag) => ({
    params: { tag }, props: { tag, posts: allPosts.filter((post) => post.data.tags.includes(tag)) }
  }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag} — ${SITE.name}`} description={`带有 ${tag} 标签的文章。`}>
  <div class="container">
    <header class="page-header"><Breadcrumbs items={[{ label: '标签', href: '/tags/' }, { label: `#${tag}` }]} /><div class="eyebrow">Tag</div><h1>#{tag}</h1><p>{posts.length} 篇文章</p></header>
    <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
    <a class="back-link" href="/tags/">← 返回全部标签</a>
  </div>
</BaseLayout>

